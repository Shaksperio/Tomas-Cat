{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matrix Explorer Observation Bundle v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "project", "generatedAt", "status", "mission",
    "environment", "worldInventory", "navigation", "interaction",
    "observations", "pageErrors", "consoleErrors", "screenshots", "worldMap"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "project": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["passed", "failed"] },
    "mission": { "$ref": "mission.schema.json" },
    "environment": { "type": "object" },
    "worldInventory": { "type": "object" },
    "navigation": { "type": "object" },
    "interaction": { "type": "object" },
    "observations": { "type": "object" },
    "pageErrors": { "type": "array", "items": { "type": "string" } },
    "consoleErrors": { "type": "array", "items": { "type": "string" } },
    "screenshots": { "type": "array", "items": { "type": "string" } },
    "worldMap": { "type": "string" }
  }
}
