   public applyReadyPlacements(placements: readonly ReadyConstructionPlacement[]): number {
     let spawned = 0;
     for (const p of placements) {
       if (!isApprovedConstructionAsset(p.assetId)) continue;
       const key = `${p.projectId}:${p.placementIndex}`;
       if (this.constructions.has(key)) continue;
       const structure = createModuleMesh(p.assetId);
       structure.position.set(p.x, 0, p.z);
       structure.rotation.y = p.rotationY;
       this.scene.add(structure);
       this.constructions.set(key, structure);
       spawned += 1;
     }
     return spawned;
   }
